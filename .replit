modules = ["nodejs-20", "web", "postgresql-16"]
run = "npm run dev"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "npm run dev"]

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 3002

[[ports]]
localPort = 3003
externalPort = 3003

[[ports]]
localPort = 3004
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 5000

[workflows]
runButton = "Dev Server"

[[workflows.workflow]]
name = "Backend Server"
author = 41107035
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && npm run dev"

[[workflows.workflow]]
name = "Frontend Server"
author = 41107035
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run dev"

[[workflows.workflow]]
name = "Dev Servers"
author = 41107035
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && npm run dev"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run dev"

[[workflows.workflow]]
name = "Dev Server"
author = 41107035
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && npm run dev"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run dev"

[[workflows.workflow]]
name = "Test Scraper"
author = 41107035
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && node scripts/setupPuppeteer.js && USE_MOCK_DATA=true node scripts/testScraper.js"

[[workflows.workflow]]
name = "Test Scraper (Real Data)"
author = 41107035
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && node scripts/setupPuppeteer.js && USE_MOCK_DATA=false node scripts/testScraper.js"

[[workflows.workflow]]
name = "Test Real Scraper"
author = 41107035
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && node scripts/setupPuppeteer.js && USE_MOCK_DATA=false node scripts/testScraper.js"

[[workflows.workflow]]
name = "Test Real Scraper with Debug"
author = 41107035
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && node scripts/setupPuppeteer.js && USE_MOCK_DATA=false DEBUG=puppeteer:* node scripts/testScraper.js"
