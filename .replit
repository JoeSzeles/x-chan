modules = ["nodejs-20", "web", "postgresql-16"]
run = "npm run dev"

[[deployment.responseHeaders]]
path = "/*.js"
name = "Content-Type"
value = "application/javascript"

[[deployment.responseHeaders]]
path = "/assets/*.js"
name = "Content-Type"
value = "application/javascript"

[[deployment.responseHeaders]]
path = "/*-*.js"
name = "Content-Type"
value = "application/javascript"

[[deployment.responseHeaders]]
path = "/assets/*-*.js"
name = "Content-Type"
value = "application/javascript"

[[deployment.rewrites]]
from = "/*"
to = "/index.html"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "node backend/server.js"]
build = ["sh", "-c", "cd frontend && npm run build"]

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 3002

[[ports]]
localPort = 3003
externalPort = 3003

[[ports]]
localPort = 3004
externalPort = 3000

[[ports]]
localPort = 3005
externalPort = 4200

[[ports]]
localPort = 3006
externalPort = 5173

[[ports]]
localPort = 3007
externalPort = 6000

[[ports]]
localPort = 3008
externalPort = 6800

[[ports]]
localPort = 3009
externalPort = 8000

[[ports]]
localPort = 3010
externalPort = 8008

[[ports]]
localPort = 3011
externalPort = 8080

[[ports]]
localPort = 3012
externalPort = 8081

[[ports]]
localPort = 3013
externalPort = 8099

[[ports]]
localPort = 5000
externalPort = 5000

[workflows]
runButton = "Deep Clean and Rebuild"

[[workflows.workflow]]
name = "Backend Server"
author = 41107035
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && npm run dev"

[[workflows.workflow]]
name = "Frontend Server"
author = 41107035
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run dev"

[[workflows.workflow]]
name = "Dev Servers"
author = 41107035
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && npm run dev"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run dev"

[[workflows.workflow]]
name = "Dev Server"
author = 41107035
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && npm run dev"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run dev"

[[workflows.workflow]]
name = "Production Build"
author = 41107035
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run build"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && npm start"

[[workflows.workflow]]
name = "Clear Cache and Restart"
author = 41107035
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && rm -rf node_modules/.vite"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run build"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && npm run dev"

[[workflows.workflow]]
name = "Clear Cache and Rebuild"
author = 41107035
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && rm -rf node_modules/.vite"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run build"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && npm run dev"

[[workflows.workflow]]
name = "Hard Reset and Rebuild"
author = 41107035
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && rm -rf node_modules/.cache"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && rm -rf node_modules/.vite"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run build"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && npm run dev"

[[workflows.workflow]]
name = "Deep Clean and Rebuild"
author = 41107035
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && rm -rf node_modules/.vite"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && rm -rf node_modules/.cache"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && rm -rf dist"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run build"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && npm run dev"
