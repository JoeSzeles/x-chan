{
	"name": "twitter-clone",
	"version": "1.0.0",
	"description": "A Twitter clone built with MERN stack",
	"scripts": {
		"start": "cd backend && npm start",
		"server": "cd backend && npm run dev",
		"client": "cd frontend && npm run dev",
		"dev": "concurrently \"npm run server\" \"npm run client\"",
		"ngrok": "ngrok start --all --config=ngrok.yml",
		"install-all": "npm install && cd backend && npm install && cd ../frontend && npm install"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"axios": "^1.9.0",
		"bcryptjs": "^2.4.3",
		"cloudinary": "^2.6.0",
		"cookie-parser": "^1.4.6",
		"cors": "^2.8.5",
		"dotenv": "^16.0.3",
		"express": "^4.18.2",
		"jsonwebtoken": "^9.0.2",
		"mongoose": "^7.0.3",
		"multer": "^1.4.5-lts.1",
		"uuid": "^11.1.0"
	},
	"devDependencies": {
		"@vitejs/plugin-react": "^4.4.1",
		"concurrently": "^8.0.1",
		"vite": "^6.3.5"
	}
}
