		"@types/react": "^19.1.4",
		"@types/react-dom": "^19.1.5",
		"@yimura/scraper": "^1.2.4",
		"autoprefixer": "^10.4.21",
		"axios": "^1.9.0",
		"bcryptjs": "^2.4.3",
		"cloudinary": "^2.6.0",
		"cookie-parser": "^1.4.6",
		"cors": "^2.8.5",
		"daisyui": "^5.0.35",
		"dotenv": "^16.0.3",
		"eslint": "^9.26.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.20",
		"express": "^4.18.2",
		"jsonwebtoken": "^9.0.2",
		"mongoose": "^7.0.3",
		"multer": "^1.4.5-lts.1",
		"nodemon": "^3.1.10",
		"pg": "^8.16.0",
		"postcss": "^8.5.3",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-hot-toast": "^2.5.2",
